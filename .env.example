PORTFOLIO_DATABASE_URL=sqlite:///./portfolio.db
PORTFOLIO_CORS_ORIGINS=["http://localhost:3000"]
PORTFOLIO_CACHE_TTL_SECONDS=3600
PORTFOLIO_CACHE_MAX_ENTRIES=32
PORTFOLIO_PROVIDER_TIMEOUT_SECONDS=15
PORTFOLIO_MAX_CONCURRENT_ANALYSES=2
PORTFOLIO_MAX_BACKTEST_REBALANCES=200
# Research assistant (optional). Leave the key unset to disable the assistant.
# When enabled, analysis summaries and chat messages are sent to Anthropic.
PORTFOLIO_ANTHROPIC_API_KEY=
PORTFOLIO_ASSISTANT_MODEL=claude-sonnet-5
PORTFOLIO_ASSISTANT_MAX_OUTPUT_TOKENS=1500
PORTFOLIO_ASSISTANT_MAX_TOOL_ROUNDS=6
PORTFOLIO_ASSISTANT_MAX_ANALYSES_PER_TURN=2
PORTFOLIO_ASSISTANT_MAX_CONCURRENT_TURNS=2
